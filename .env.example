# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL (Supabase Database settings → URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/still

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser. Required to delete the Auth user.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile. The site key is public. The secret stays on the server and must never use a NEXT_PUBLIC_ name.
# Development can run without these. Production refuses account actions until both are set, and does not pretend CAPTCHA is active.
# STILL checks the token on its own server. Leave the Supabase Auth CAPTCHA setting off unless you accept that a token can only be checked once.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Google OAuth after enabling the provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Language interpretation. none | openai | anthropic
# AI_BASE_URL is optional. Set it for any OpenAI-compatible endpoint
# (Groq, Together, OpenRouter, NVIDIA). Leave it empty for api.openai.com.
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email. none | resend | log
EMAIL_PROVIDER=none
RESEND_API_KEY=
EMAIL_FROM=Still <still@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Server-side reminder processing. Required in production.
# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Optional Google Calendar / Docs. Leave empty; Still will not invent events or documents.
# Register this redirect: {NEXT_PUBLIC_APP_URL}/connectors/google-calendar/callback
# Push notifications: {NEXT_PUBLIC_APP_URL}/webhooks/google-calendar
# Watch channels require a public HTTPS URL. Localhost stays degraded and reconciles via /api/cron/connectors.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=

# Official Telegram bot. Required to connect Telegram. Never ask users for passwords or session files.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Official Meta Cloud API only. Leave empty unless you have permitted credentials.
# STILL will not scrape WhatsApp or Instagram and will not pretend they are connected.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_SECRET=
GMAIL_ENABLED=false

# Guest extract daily cap per IP. Real limit, not a signup wall.
GUEST_EXTRACT_DAILY_LIMIT=24

# Isolated development seed. Never set in production.
STILL_ALLOW_SEED=false

# Legal operator. Leave empty until real details exist. Do not invent them.
STILL_OPERATOR_LEGAL_NAME=
STILL_CONTACT_EMAIL=
STILL_SUPPORT_EMAIL=
STILL_BUSINESS_ADDRESS=
STILL_JURISDICTION=
